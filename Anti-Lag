buttonCorner.CornerRadius = UDim.new(0, 8)
buttonCorner.Parent = button

local is3DRenderingEnabled = true

local function applyState()
    -- Keep mouse cursor visible
    UserInputService.MouseIconEnabled = true
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default

    -- Toggle engine 3D rendering
    RunService:Set3dRenderingEnabled(is3DRenderingEnabled)

    -- Black overlay when 3D is OFF
    overlay.Visible = not is3DRenderingEnabled

    -- Update button visuals
    if is3DRenderingEnabled then
        button.BackgroundColor3 = Color3.fromRGB(34, 197, 94) -- green
        button.Text = "3D: ON"
    else
        button.BackgroundColor3 = Color3.fromRGB(239, 68, 68) -- red
        button.Text = "3D: OFF"
    end
end

button.MouseButton1Click:Connect(function()
    is3DRenderingEnabled = not is3DRenderingEnabled
    applyState()
end)

closeButton.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Dragging
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

frame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end
end)

-- Apply initial state
applyState()
